# Pionex Partner KOL TG Bot — Bonnie 版（多帳號）設定範本
# 複製成 .env 後填入實際值：cp .env.example .env

# ──────────────────────────────────────────────────────────────
# 帳號 A（Bonnie 推薦碼 1 對應的 Pionex 帳號）
# ──────────────────────────────────────────────────────────────
# Pionex → Account Dashboard → API Management → Create API Key
# 必須勾選 "Partner reading"
PIONEX_A_API_KEY=
PIONEX_A_API_SECRET=

# 在這個帳號的 Partner Web → Bot Management 建兩個 Open-API Bot：
# 1) KOL 檢查用，Min Balance 留空或 0
PIONEX_A_BOT_ID_KOL=
# 2) 資產門檻檢查用，Min Balance = 200（或你想要的）
PIONEX_A_BOT_ID_ASSET=

# 顯示用標籤（出現在回覆裡，方便分辨）
PIONEX_A_LABEL=帳號 A

# ──────────────────────────────────────────────────────────────
# 帳號 B（Bonnie 推薦碼 2 對應的 Pionex 帳號）
# ──────────────────────────────────────────────────────────────
PIONEX_B_API_KEY=
PIONEX_B_API_SECRET=
PIONEX_B_BOT_ID_KOL=
PIONEX_B_BOT_ID_ASSET=
PIONEX_B_LABEL=帳號 B

# ──────────────────────────────────────────────────────────────
# 共用設定
# ──────────────────────────────────────────────────────────────
# /asset 回覆中要顯示的門檻字串（不影響 API；需與 _BOT_ID_ASSET 上設的 Min Balance 一致）
PIONEX_ASSET_THRESHOLD_LABEL=200 USDT

# Bonnie 原本的 TG bot Token（沿用，請先確認舊 bot 程式已停掉避免衝突）
TELEGRAM_BOT_TOKEN=

# 允許的 TG 群組 chat_id，多個用逗號分隔
ALLOWED_CHAT_IDS=

# ──────────────────────────────────────────────────────────────
# 進階：若有第三、第四個帳號可繼續加，命名規則 PIONEX_<SUFFIX>_*
# 程式會自動掃出所有 PIONEX_<SUFFIX>_API_KEY，建立對應的 Account
# ──────────────────────────────────────────────────────────────
